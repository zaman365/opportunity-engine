# INVENTORY ONLY. Not a working deployment. No secrets in this file.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4178
AUTH_MODE=fixture_local_only
# Deployed builds MUST use access_jwt and reject fixture_local_only.
ACCESS_ISSUER=
ACCESS_AUDIENCE=
DATABASE_URL=
MIGRATION_DATABASE_URL=
LEDGER_CURRENCY=USD
# Limit set by owner; zero means no chargeable live work allowed.
LIVE_SPEND_LIMIT_MICRO=0
LIVE_CAPTURE_ENABLED=false
PUBLIC_INTAKE_ENABLED=false
AUTOMATIC_OUTREACH_ENABLED=false
AUTOMATIC_PRODUCTION_WRITES_ENABLED=false
AUTOMATIC_TOPUPS_ENABLED=false
# Worker resource bindings belong to reviewed environment config, not invented IDs here.
