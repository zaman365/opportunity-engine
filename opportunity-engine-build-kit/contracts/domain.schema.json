{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opportunity-engine.invalid/contracts/domain.schema.json",
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_micro": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,14})$"
        }
      },
      "required": [
        "currency",
        "amount_micro"
      ]
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "request_id",
        "retryable"
      ]
    },
    "Role": {
      "enum": [
        "viewer",
        "operator",
        "reviewer",
        "owner"
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "active_tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "venture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "csrf_token": {
          "type": "string",
          "minLength": 20
        },
        "environment": {
          "enum": [
            "local",
            "staging",
            "production"
          ]
        }
      },
      "required": [
        "subject",
        "active_tenant_id",
        "role",
        "venture_ids",
        "csrf_token",
        "environment"
      ]
    },
    "CreateAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "canonical_domain": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "venture_id": {
          "type": "string",
          "format": "uuid"
        },
        "approved_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "canonical_domain",
        "venture_id",
        "approved_hosts",
        "source_note"
      ]
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_domain": {
          "type": "string",
          "minLength": 1
        },
        "venture_id": {
          "type": "string",
          "format": "uuid"
        },
        "approved_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "canonical_domain",
        "venture_id",
        "approved_hosts",
        "version",
        "created_at"
      ]
    },
    "AuthorizationInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "scan_public",
            "publish_internal_report"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "purpose",
        "evidence_note",
        "expires_at",
        "policy_version"
      ]
    },
    "Authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "enum": [
            "scan_public",
            "publish_internal_report"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "account_id",
        "action",
        "expires_at",
        "revoked_at",
        "policy_version"
      ]
    },
    "CreateScan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "venture_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096
        },
        "authorization_id": {
          "type": "string",
          "format": "uuid"
        },
        "max_unique_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "detectors": {
          "type": "array",
          "items": {
            "const": "MF-LINK-01"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "max_cost": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "account_id",
        "venture_id",
        "target_url",
        "authorization_id",
        "max_unique_pages",
        "detectors",
        "max_cost"
      ]
    },
    "Scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "venture_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "queued",
            "validating",
            "capturing",
            "analysing",
            "cancel_requested",
            "succeeded",
            "partial",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "target_url": {
          "type": "string",
          "format": "uri"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected_unique_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "captured_unique_pages": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "complete_checks": {
              "type": "integer",
              "minimum": 0
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "expected_unique_pages",
            "captured_unique_pages",
            "complete_checks",
            "reasons"
          ]
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cap": {
              "$ref": "#/$defs/Money"
            },
            "settled": {
              "$ref": "#/$defs/Money"
            },
            "reserved": {
              "$ref": "#/$defs/Money"
            },
            "settlement_uncertain": {
              "type": "boolean"
            }
          },
          "required": [
            "cap",
            "settled",
            "reserved",
            "settlement_uncertain"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "account_id",
        "venture_id",
        "state",
        "version",
        "target_url",
        "created_at",
        "updated_at",
        "coverage",
        "cost",
        "evidence_ids",
        "finding_ids",
        "blocked_reason"
      ]
    },
    "CaptureConditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "viewport_width": {
          "type": "integer",
          "minimum": 1
        },
        "viewport_height": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "variant": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "consent_state": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": "string",
          "minLength": 1
        },
        "test_region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "captured_at",
        "session_id",
        "viewport_width",
        "viewport_height",
        "locale",
        "variant",
        "consent_state",
        "browser_version",
        "test_region"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scan_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "final_url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "enum": [
            "screenshot",
            "http_observation",
            "dom_observation"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "conditions": {
          "$ref": "#/$defs/CaptureConditions"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_available": {
          "type": "boolean"
        },
        "redacted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scan_id",
        "asset_id",
        "source_url",
        "final_url",
        "kind",
        "sha256",
        "conditions",
        "http_status",
        "complete",
        "expires_at",
        "content_available",
        "redacted"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scan_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "detector_id": {
          "type": "string",
          "minLength": 1
        },
        "detector_version": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "candidate",
            "confirmed",
            "rejected",
            "unknown",
            "stale"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "root_cause_key": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "contrary_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1
        },
        "evidence_grade": {
          "enum": [
            "A",
            "B",
            "C",
            null
          ]
        },
        "commercial_impact": {
          "enum": [
            "unknown",
            "hypothesis",
            "measured_noncausal",
            "validated_causal"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "scan_id",
        "asset_id",
        "detector_id",
        "detector_version",
        "state",
        "version",
        "root_cause_key",
        "claim",
        "evidence_ids",
        "contrary_evidence_ids",
        "scope",
        "limitations",
        "evidence_grade",
        "commercial_impact",
        "captured_at",
        "reviewer_id",
        "reviewed_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "reviewer_id": {
                "type": "string",
                "format": "uuid"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_grade": {
                "enum": [
                  "A",
                  "B"
                ]
              }
            }
          }
        }
      ]
    },
    "ReviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "enum": [
            "confirm",
            "reject",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "acknowledged_limitations": {
          "const": true
        }
      },
      "required": [
        "expected_version",
        "decision",
        "reason",
        "acknowledged_limitations"
      ]
    },
    "PriorityScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelVersion": {
          "const": "priority-v1"
        },
        "pointScore": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "lowerBound": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "upperBound": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weightedCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rankable": {
          "type": "boolean"
        },
        "unknown": {
          "type": "array",
          "items": {
            "enum": [
              "fit",
              "need",
              "deliverability",
              "timing",
              "value"
            ]
          },
          "uniqueItems": true
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contribution": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "weight",
                "value",
                "contribution"
              ]
            },
            "need": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contribution": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "weight",
                "value",
                "contribution"
              ]
            },
            "deliverability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contribution": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "weight",
                "value",
                "contribution"
              ]
            },
            "timing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contribution": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "weight",
                "value",
                "contribution"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contribution": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "weight",
                "value",
                "contribution"
              ]
            }
          },
          "required": [
            "fit",
            "need",
            "deliverability",
            "timing",
            "value"
          ]
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "modelVersion",
        "pointScore",
        "lowerBound",
        "upperBound",
        "weightedCoverage",
        "rankable",
        "unknown",
        "components",
        "interpretation"
      ]
    },
    "Opportunity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "account": {
          "$ref": "#/$defs/Account"
        },
        "venture_id": {
          "type": "string",
          "format": "uuid"
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriorityScore"
            },
            {
              "type": "null"
            }
          ]
        },
        "permission_state": {
          "enum": [
            "research_only",
            "review_allowed",
            "action_allowed",
            "blocked"
          ]
        },
        "next_action": {
          "enum": [
