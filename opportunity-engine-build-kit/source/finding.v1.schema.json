{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity Engine finding record (proposed v1)",
  "description": "Proposed contract. Schema validation is not evidence verification or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "tenant_id", "asset_id", "detector_id", "detector_version", "state", "root_cause_key", "claim", "evidence_ids", "contrary_evidence_ids", "scope", "limitations", "commercial_impact", "review_required", "captured_at"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1, "description": "Set by authenticated server context; never trust an arbitrary client tenant ID."},
    "asset_id": {"type": "string", "minLength": 1},
    "detector_id": {"type": "string", "minLength": 1},
    "detector_version": {"type": "string", "minLength": 1},
    "state": {"enum": ["candidate", "confirmed", "rejected", "unknown", "stale"]},
    "root_cause_key": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contrary_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1, "maxLength": 2000},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commercial_impact": {"enum": ["unknown", "hypothesis", "measured_noncausal", "validated_causal"]},
    "review_required": {"type": "boolean"},
    "captured_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewer_id": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "confirmed"}}, "required": ["state"]},
      "then": {"properties": {"evidence_ids": {"minItems": 1}}}
    }
  ]
}
