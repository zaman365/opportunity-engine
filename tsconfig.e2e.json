{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Playwright's page.evaluate runs in the browser, so these files legitimately reference
    // DOM globals while executing under Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["tests/e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["**/node_modules/**"]
}
