# Application environment inventory. NO SECRETS IN THIS FILE.
# Copy to .env.local for local development. Deployed environments use platform secrets.

# local | staging | production. Startup validation is stricter outside "local".
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4173

# access_jwt (required for staging/production) | fixture_local_only (rejected unless APP_ENV=local + loopback origin)
AUTH_MODE=fixture_local_only
ACCESS_ISSUER=
ACCESS_AUDIENCE=
ACCESS_JWKS_URL=

# Runtime role. MUST NOT be owner/superuser/BYPASSRLS. Migrations use MIGRATION_DATABASE_URL.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Internal cost accounting. One currency per tenant in M1. Zero means no chargeable live work.
LEDGER_CURRENCY=USD
LIVE_SPEND_LIMIT_MICRO=0

# Capture adapters. local_fixture is rejected outside APP_ENV=local.
CAPTURE_ADAPTER=local_fixture
# Comma-separated; every entry must be loopback. The kit fixture site plus the M2 fixtures.
FIXTURE_ORIGIN=http://127.0.0.1:4179,http://127.0.0.1:4180
LIVE_CAPTURE_ENABLED=false
BROWSER_RUN_ENDPOINT=

# Evidence object storage. local_fs is rejected outside APP_ENV=local.
EVIDENCE_STORE=local_fs
EVIDENCE_LOCAL_DIR=.local-evidence
R2_BUCKET=
R2_JURISDICTION=

# Capability switches. All default off; enabling requires owner authorization per AGENTS.md.
# M3 requested intake. Turning it on requires both of the two below: a public surface with no
# way to verify a contact address accepts requests from anybody about anybody, and one without
# a secret cannot hash a one-time code or key a rate-limit counter. Startup refuses otherwise.
PUBLIC_INTAKE_ENABLED=false
# not_configured | recorded_local_only. The local one returns the code to the caller and sends
# nothing; it refuses to construct outside APP_ENV=local. There is no adapter that sends mail:
# that needs owner approval it does not have.
INTAKE_VERIFICATION_CHANNEL=not_configured
# At least 32 characters, outside the database, so reading the database alone recovers neither
# a live code nor the address behind a rate-limit key.
INTAKE_SECRET=
AUTOMATIC_OUTREACH_ENABLED=false
AUTOMATIC_PRODUCTION_WRITES_ENABLED=false
AUTOMATIC_TOPUPS_ENABLED=false
