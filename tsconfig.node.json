{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "apps/api/**/*.ts",
    "workers/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "tests/e2e/**"]
}
